btw NOERR:
lowkey xs = [
    1,
    "two",
    nocap,
]
xs[0] = 10
xs[0] += 1
yap xs, clout(xs)                  btw OUT: [11, "two", nocap] 3
slide(xs, npc)
yap dip(xs), yoink(xs, 0), xs      btw OUT: npc 11 ["two", nocap]
yap [1] + [2]                      btw OUT: [1, 2]
lowkey same = xs
slide(same, 1)
yap clout(xs), xs == same, [1] == [1]   btw OUT: 3 nocap cap
lowkey loop = []
slide(loop, loop)
yap loop                           btw OUT: [[...]]

lowkey m = {
    "b": 1,
    2: "two",
}
m["a"] = [1]
yap m                              btw OUT: {"b": 1, 2: "two", "a": [1]}
yap m["nope"], m[2]                btw OUT: npc two
yap receipts(m), gotit(m, "a")     btw OUT: ["b", 2, "a"] nocap
unsend(m, "b")
yap clout(m), gotit(m, "b"), m     btw OUT: 2 cap {2: "two", "a": [1]}
m["b"] = 9
yap receipts(m)                    btw OUT: [2, "a", "b"]
speedrun i in 1..50 { m[i + 100] = i }
speedrun i in 1..50 { unsend(m, i + 100) }
yap m["a"], clout(m)               btw OUT: [1] 3

lowkey name = "bestie"
yap "hey ${name}, ${1 + 1} ${["a"][0]} ${{"k": "v"}["k"]}"   btw OUT: hey bestie, 2 a v
yap "\$notinterp $x \"q\" a\\b"    btw OUT: $notinterp $x "q" a\b
yap "${"nested ${name}"}"          btw OUT: nested bestie
yap "a\tb"                         btw OUT: a	b
yap clout("💀a"), "💀a"[1], "💀a"[0]   btw OUT: 2 a 💀
yap snip("h💀llo", 1, 2), snip("hi", 1, 99), clout(snip("hi", 9, 1))   btw OUT: 💀l i 0
yap loud("aB"), quiet("aB")        btw OUT: AB ab
yap breakup("a,b,,", ",")          btw OUT: ["a", "b", "", ""]
yap breakup("a💀", "")             btw OUT: ["a", "💀"]
yap breakup("abc", "x")            btw OUT: ["abc"]
yap linkup([1, "b", nocap], "-")   btw OUT: 1-b-nocap
yap gotit("hello", "ell"), gotit([1, "a"], "a"), gotit([], 1)   btw OUT: nocap nocap cap

yap vibeof(1), vibeof(""), vibeof(cap), vibeof(npc), vibeof([]), vibeof({}), vibeof(clout)   btw OUT: number string bool npc list map function
yap towords(12) + "!", todigits("3.5") + 1, todigits(" 7 "), todigits("nan"), todigits("0x10"), todigits([])   btw OUT: 12! 4.5 7 npc npc npc
yap floor(1.7), ceil(1.2), round(1.5), abs(-3), sqrt(16)   btw OUT: 1 2 2 3 4
lowkey r = rng(3, 3)
yap r, vibeof(rn())                btw OUT: 3 number
nap(1)
